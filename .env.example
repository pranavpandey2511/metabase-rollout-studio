# Never commit the real values in .env.
GEMINI_API_KEY=
DEFAULT_COMPUTER_USE_MODEL=gemini-3.6-flash
# Optional comma-separated allowlist for the evaluation model selector.
COMPUTER_USE_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-computer-use-preview-10-2025
METABASE_EMAIL=daksh@deeptune.com
METABASE_PASSWORD=
METABASE_IMAGE=metabase/metabase:v0.58.5
METABASE_URLS=http://localhost:33000
COMPUTER_USE_DIR=work/computer-use-preview
# Use the shared project virtual environment for the Gemini/Playwright child process.
COMPUTER_USE_PYTHON=.venv/bin/python
# Local auto-start supports one or two environments. For 2, also add :33001 to METABASE_URLS.
MAX_PARALLEL_ROLLOUTS=1
# Dashboard maximum K. The backend and UI both read this value.
MAX_ATTEMPTS_PER_PROBLEM=10
# Safety ceiling for problem count multiplied by K.
MAX_ROLLOUTS_PER_EVALUATION=100
# Reject unexpectedly large uploads before any API-consuming work starts.
MAX_TASK_FILE_BYTES=2000000
ROLLOUT_TIMEOUT_SECONDS=600
# If Metabase is unavailable when a valid job is submitted, repair the local Docker environment automatically.
AUTO_START_ENVIRONMENT=true
# auto uses a running active Docker context (for Docker Desktop) first, then Colima.
# Set docker or colima only to force one backend.
DOCKER_BACKEND=auto
ENVIRONMENT_START_TIMEOUT_SECONDS=180
ENVIRONMENT_HEALTH_TIMEOUT_SECONDS=5
SHUTDOWN_GRACE_SECONDS=15
# Local runtime parameters. Configure METABASE_URLS with :33000 and optionally :33001.
COLIMA_CPU=4
COLIMA_MEMORY_GB=4
COLIMA_DISK_GB=60
ENVIRONMENT_HEALTH_WAIT_SECONDS=120
TUNNEL_REPAIR_WAIT_SECONDS=5
