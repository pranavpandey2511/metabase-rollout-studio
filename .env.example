# Never commit the real values in .env.
GEMINI_API_KEY=
DEFAULT_COMPUTER_USE_MODEL=gemini-3.6-flash
# Optional comma-separated allowlist for the evaluation model selector.
COMPUTER_USE_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-computer-use-preview-10-2025
METABASE_EMAIL=daksh@deeptune.com
METABASE_PASSWORD=
METABASE_IMAGE=metabase/metabase:v0.58.5
METABASE_URLS=http://localhost:33000
COMPUTER_USE_DIR=work/computer-use-preview
# Use the shared project virtual environment for the Gemini/Playwright child process.
COMPUTER_USE_PYTHON=.venv/bin/python
MAX_PARALLEL_ROLLOUTS=1
# Dashboard maximum K. The backend and UI both read this value.
MAX_ATTEMPTS_PER_PROBLEM=10
ROLLOUT_TIMEOUT_SECONDS=600
